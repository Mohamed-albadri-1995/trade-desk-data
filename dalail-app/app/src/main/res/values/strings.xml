<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">دلائل الرحمات</string>
    <string name="subtitle">الصلوات العلية بأسماء السور القرآنية\nخواطر العبد الفقير إلى مولاه القدير — أبو إدريس</string>

    <string name="page_of">%1$s / %2$s</string>
    <string name="a_leaf">صفحة من الكتاب</string>

    <!--
        The book is read a حزب a day. The Islamic day turns at sunset, so what
        is read on a Sunday evening is Monday's حزب — «ليلة الاثنين» — and the
        app says so rather than calling it Sunday's.
    -->
    <string name="ward_day">وِرد يوم %1$s</string>
    <string name="ward_night">وِرد ليلة %1$s</string>
    <string name="ward_of_today">ورد اليوم</string>
    <string name="open_ward">افتح الورد</string>
    <string name="carry_on">أكمل من حيث وقفت</string>

    <string name="reminder">تنبيه الورد</string>
    <string name="reminder_off">أوقف التنبيه</string>
    <string name="channel_ward">تنبيه الورد</string>
    <string name="channel_ward_about">تنبيهٌ يوميٌّ بحزب الورد، في وقته</string>

    <string-array name="week_days">
        <item>الأحد</item>
        <item>الاثنين</item>
        <item>الثلاثاء</item>
        <item>الأربعاء</item>
        <item>الخميس</item>
        <item>الجمعة</item>
        <item>السبت</item>
    </string-array>
    <!-- Only ever seen if the leaves could not be read from the package. -->
    <string name="no_leaves">تعذّر فتح أوراق الكتاب على هذا الجهاز.\nأعد تثبيت التطبيق، فإن بقي الحال فأبلغنا.</string>
    <!--
        Written on the leaf itself when it cannot be drawn. Plain enough for a
        reader to photograph and send, and precise enough to act on.
    -->
    <string name="leaf_missing">لم أجد هذه الورقة في التطبيق\n%1$s\n(%2$s)</string>
    <string name="leaf_undrawable">تعذّر رسم هذه الورقة\n%1$s\n(%2$s — %3$d)</string>

    <!-- The build, so a photograph of the app can be tied to a version. -->
    <string name="build_line">بناء %1$s</string>
</resources>
