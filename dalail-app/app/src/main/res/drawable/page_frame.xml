<?xml version="1.0" encoding="utf-8"?>
<!--
    The leaf: parchment inside the book's ruled border — a stout gold rule with
    a fine one just inside it, as the printed page has.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/reading_bg" />
        </shape>
    </item>

    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/rule" />
        </shape>
    </item>

    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1px"
                android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
