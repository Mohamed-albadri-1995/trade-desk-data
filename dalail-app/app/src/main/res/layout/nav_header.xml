<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/board"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amiri"
        android:text="@string/app_name"
        android:textColor="@color/rule"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/amiri"
        android:gravity="center"
        android:text="@string/subtitle"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!--
        Which build this is. Without it a photograph of the app cannot be tied
        to a version, and a fault reported against one build may already have
        been mended in another.
    -->
    <TextView
        android:id="@+id/buildLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/amiri"
        android:gravity="center"
        android:textColor="@color/rule_faint"
        android:textSize="12sp" />
</LinearLayout>
