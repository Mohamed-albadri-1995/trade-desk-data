<?xml version="1.0" encoding="utf-8"?>
<!-- Strong dark gradient at the bottom so the title panel is readable over a bright photo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#EE000000"
        android:centerColor="#59000000"
        android:endColor="#10000000"
        android:type="linear" />
</shape>
